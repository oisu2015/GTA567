<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 风格选中态：柔和放大 + 一圈低透明度光晕（负 inset 外扩）+ 细柔光描边 + 圆角。
     比原金边更克制、更接近 tvOS 的「抬起发光」质感。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔光外晕：比卡片大一圈的低透明度暖色，模拟选中时的环境光 -->
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFE9A8" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <!-- 卡片主体：深灰半透明底 + 细柔光描边 + 圆角 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3a3a3a" />
            <stroke android:width="2.5dp" android:color="#FFE9A8" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
