<?xml version="1.0" encoding="utf-8"?>
<!-- 影视源按钮（m3u8 等）：灰色、不明显，与深蓝背景融合 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部阴影 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#50000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 按钮主体：深灰 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#424242"
                android:centerColor="#383838"
                android:endColor="#303030"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#555555" />
        </shape>
    </item>
</layer-list>
