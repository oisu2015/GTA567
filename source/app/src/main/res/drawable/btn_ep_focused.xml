<?xml version="1.0" encoding="utf-8"?>
<!-- 选集按钮：遥控器焦点态——亮蓝高亮 + 光晕，明显区分"当前遥控器所在集" -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光 -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#662ab6ff" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 按钮主体：渐变亮蓝 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4FC3F7"
                android:centerColor="#29B6F6"
                android:endColor="#039BE5"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#B3E5FC" />
        </shape>
    </item>
</layer-list>
